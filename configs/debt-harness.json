{
  "version": 1,
  "output_dir": ".debt",
  "exclude_dirs": [
    ".git",
    ".debt",
    ".venv",
    "venv",
    "env",
    "node_modules",
    "dist",
    "build",
    "target",
    ".mypy_cache",
    ".ruff_cache",
    "__pycache__",
    "coverage",
    ".next",
    "out",
    ".turbo",
    ".cache",
    ".pytest_cache",
    "htmlcov",
    "vendor",
    "third_party",
    "3rdparty",
    "external",
    "generated",
    "gen",
    "cmake-build-debug",
    "cmake-build-release",
    "Debug",
    "Release",
    "x64",
    "bin",
    "obj"
  ],
  "tools": {
    "eslint": {
      "enabled": "auto",
      "languages": [
        "typescript"
      ],
      "command": [
        "npx",
        "eslint",
        ".",
        "--format",
        "json"
      ],
      "principal_multiplier": 1.0
    },
    "tsc": {
      "enabled": "auto",
      "languages": [
        "typescript"
      ],
      "command": [
        "npx",
        "tsc",
        "-p",
        "tsconfig.json",
        "--noEmit",
        "--pretty",
        "false"
      ],
      "principal_multiplier": 1.15
    },
    "ruff": {
      "enabled": "auto",
      "languages": [
        "python"
      ],
      "command": [
        "ruff",
        "check",
        ".",
        "--output-format",
        "json",
        "--exclude",
        "node_modules",
        "--exclude",
        "dist",
        "--exclude",
        "build",
        "--exclude",
        "target",
        "--exclude",
        ".debt"
      ],
      "principal_multiplier": 0.8
    },
    "mypy": {
      "enabled": "auto",
      "languages": [
        "python"
      ],
      "command": [
        "mypy",
        ".",
        "--no-error-summary",
        "--show-column-numbers",
        "--show-error-codes",
        "--exclude",
        "(node_modules|dist|build|target|\\.debt|\\.venv|venv|env)"
      ],
      "principal_multiplier": 1.15
    },
    "bandit": {
      "enabled": "auto",
      "languages": [
        "python"
      ],
      "command": [
        "bandit",
        "-r",
        ".",
        "-f",
        "json",
        "-q",
        "-x",
        "./node_modules,./dist,./build,./target,./.debt,./.venv,./venv,./env"
      ],
      "principal_multiplier": 1.5
    },
    "semgrep": {
      "enabled": "auto",
      "languages": [
        "typescript",
        "python",
        "c_cpp",
        "rust"
      ],
      "command": [
        "semgrep",
        "scan",
        "--config",
        ".semgrep.yml",
        "--json",
        "--quiet",
        "--exclude",
        "node_modules",
        "--exclude",
        "dist",
        "--exclude",
        "build",
        "--exclude",
        "target",
        "--exclude",
        ".debt"
      ],
      "principal_multiplier": 1.4
    },
    "cppcheck": {
      "enabled": "auto",
      "languages": [
        "c_cpp"
      ],
      "principal_multiplier": 1.2
    },
    "clang_tidy": {
      "enabled": "auto",
      "languages": [
        "c_cpp"
      ],
      "requires_compile_commands": true,
      "principal_multiplier": 1.3
    },
    "clippy": {
      "enabled": "auto",
      "languages": [
        "rust"
      ],
      "command": [
        "cargo",
        "clippy",
        "--all-targets",
        "--all-features",
        "--message-format",
        "json"
      ],
      "principal_multiplier": 1.0
    },
    "cargo_audit": {
      "enabled": "auto",
      "languages": [
        "rust"
      ],
      "command": [
        "cargo",
        "audit",
        "--json"
      ],
      "principal_multiplier": 2.0
    }
  },
  "severity_principal_minutes": {
    "critical": 120,
    "high": 60,
    "medium": 30,
    "low": 12,
    "info": 5
  },
  "severity_monthly_interest_rate": {
    "critical": 0.35,
    "high": 0.25,
    "medium": 0.12,
    "low": 0.05,
    "info": 0.02
  },
  "gates": {
    "max_new_critical": 0,
    "max_new_high": 0,
    "max_monthly_interest_delta_minutes": 60,
    "max_total_issue_delta": 25,
    "fail_on_tool_crash": false
  }
}
